{
  "name": "market-home",
  "version": "0.1.0",
  "private": true,
  "description": "Вёрстка главной страницы интернет-магазина «Маркет» и UI-кит по макету Figma",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/images.mjs",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write . && stylelint \"src/**/*.scss\" --fix"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@spiriit/vite-plugin-svg-spritemap": "^7.2.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "svgo": "^4.1.0",
    "vite": "^8.3.8",
    "vite-plugin-handlebars": "^2.0.3"
  }
}
