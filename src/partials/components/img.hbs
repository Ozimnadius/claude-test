{{!--
  Картинка WebP из src/assets/images (готовятся командой npm run images).
  Параметры: name — имя файла без .webp; alt; width, height — размер в CSS-пикселях;
  eager — грузить сразу (первый экран). Вариант name@2x.webp, если он есть, добавляется в srcset
  автоматически (хелпер has2x); параметр retina больше не нужен и игнорируется;
  class — классы.
  Пример: {{> components/img name="product-watch" alt="Умные часы" width="249" height="249" class="product-card__img"}}
--}}
<img{{#if class}} class="{{class}}"{{/if}} src="/src/assets/images/{{name}}.webp"{{#if (has2x name)}} srcset="/src/assets/images/{{name}}.webp 1x, /src/assets/images/{{name}}@2x.webp 2x"{{/if}} alt="{{alt}}"{{#if width}} width="{{width}}"{{/if}}{{#if height}} height="{{height}}"{{/if}}{{#if eager}} fetchpriority="high"{{else}} loading="lazy"{{/if}} decoding="async">
