{{!--
  Пункт меню (scss/components/_menu-link.scss).
  Параметры: text, href (иначе <button>); arrow — стрелка вниз (пункт с подменю);
  inline — без полей; lg — текст 15 px; active — текущий раздел.
  Пример: {{> components/menu-link text="Услуги" href="#" arrow=true}}
--}}
{{#if href}}<a class="menu-link{{#if inline}} menu-link--inline{{/if}}{{#if lg}} menu-link--lg{{/if}}{{#if active}} is-active{{/if}}" href="{{href}}"{{#if active}} aria-current="page"{{/if}}>{{else}}<button class="menu-link{{#if inline}} menu-link--inline{{/if}}{{#if lg}} menu-link--lg{{/if}}" type="button"{{#if arrow}} aria-expanded="false"{{/if}}>{{/if}}
  <span class="menu-link__text">{{text}}</span>
  {{#if arrow}}{{> components/icon name="chevron-down" class="menu-link__arrow" size="16" label=""}}{{/if}}
{{#if href}}</a>{{else}}</button>{{/if}}
