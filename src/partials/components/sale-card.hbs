{{!--
  Карточка акции (scss/components/_sale-card.scss).
  Параметры: title, image, retina, href (по умолчанию #); dates — период («С 25 октября по 2 ноября»);
  discount — плашка («до −50%»); timer — { days, hours, minutes, end }: остаток до конца акции.
  Отсчёт — modules/countdown.js: с end (дата ISO) — до этой даты, без него (демо) — от момента загрузки страницы.
  Пример: {{> components/sale-card data.cards.sale}}
--}}
<article class="sale-card">
  <div class="sale-card__media">
    {{> components/img name=image alt="" width="484" height="324" sizes="(max-width: 575px) 286px, 31vw" retina=retina class="sale-card__img" eager=false}}
    <div class="sale-card__badges">
      {{#if discount}}<span class="sale-card__discount">{{discount}}</span>{{/if}}
      {{#if timer}}
        <span class="sale-card__timer" role="timer" aria-label="До конца акции {{timer.days}} д {{timer.hours}} ч {{timer.minutes}} мин" data-countdown="{{timer.days}}:{{timer.hours}}:{{timer.minutes}}"{{#if timer.end}} data-countdown-end="{{timer.end}}"{{/if}}>
          {{> components/icon name="fire" class="sale-card__fire" size="18" label=""}}
          <span aria-hidden="true"><span data-countdown-days>{{timer.days}}</span>д</span><span class="sale-card__sep" aria-hidden="true"></span><span aria-hidden="true"><span data-countdown-hours>{{timer.hours}}</span>ч</span><span class="sale-card__sep" aria-hidden="true"></span><span aria-hidden="true"><span data-countdown-minutes>{{timer.minutes}}</span>м</span>
        </span>
      {{/if}}
    </div>
  </div>
  <div class="sale-card__body">
    <a class="sale-card__title" href="{{#if href}}{{href}}{{else}}#{{/if}}">{{title}}</a>
    {{#if dates}}<p class="sale-card__dates">{{dates}}</p>{{/if}}
  </div>
</article>
