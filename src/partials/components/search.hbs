{{!--
  Поиск в шапке (scss/components/_search.scss): поле, выбор области поиска и кнопка-лупа.
  Параметры:
    id          — префикс для id элементов (поиск на странице может быть не один), по умолчанию «search»;
    placeholder — подсказка в поле (по умолчанию «Найти»).
  Области поиска — data.header.searchScopes; выбранная пишется в скрытое поле scope (modules/dropdown.js).
--}}
<form class="search" action="#" role="search">
  <input class="search__input" id="{{or id "search"}}-q" type="search" name="q" placeholder="{{#if placeholder}}{{placeholder}}{{else}}Найти{{/if}}" aria-label="Поиск по сайту">
  <div class="search__actions">
    <div class="dropdown search__scope" data-dropdown>
      <input type="hidden" name="scope" value="{{@root.data.header.searchScopes.[0]}}" data-dropdown-input>
      <button class="menu-link menu-link--inline" type="button" aria-expanded="false" aria-controls="{{or id "search"}}-scopes" data-dropdown-toggle>
        <span class="visually-hidden">Область поиска: </span>
        <span class="menu-link__text" data-dropdown-value>{{@root.data.header.searchScopes.[0]}}</span>
        {{> components/icon name="chevron-down" class="menu-link__arrow" size="16" label=""}}
      </button>
      <div class="dropdown__panel dropdown__panel--end" id="{{or id "search"}}-scopes" hidden data-dropdown-panel>
        <ul class="dropdown__list">
          {{#each @root.data.header.searchScopes}}
            <li><button class="dropdown__link" type="button" aria-pressed="{{#if @first}}true{{else}}false{{/if}}" data-dropdown-option="{{this}}">{{this}}</button></li>
          {{/each}}
        </ul>
      </div>
    </div>
    <button class="search__submit" type="submit" aria-label="Найти">{{> components/icon name="search" size="24" label="" class=""}}</button>
  </div>
</form>
