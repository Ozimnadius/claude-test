{{!--
  Переключатель светлой и тёмной темы (scss/components/_theme-switch.scss). Поведение — JS на этапе 6.
--}}
<div class="theme-switch" role="group" aria-label="Тема оформления" data-theme-switch>
  <button class="theme-switch__btn" type="button" aria-pressed="true" data-theme-value="light">{{> components/icon name="sun" size="24" label="Светлая тема" class=""}}</button>
  <button class="theme-switch__btn" type="button" aria-pressed="false" data-theme-value="dark">{{> components/icon name="moon" size="24" label="Тёмная тема" class=""}}</button>
</div>
