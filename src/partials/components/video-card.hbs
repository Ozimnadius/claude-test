{{!--
  Карточка видеоотзыва (scss/components/_video-card.scss).
  Параметры: title, date, duration («09:50»), image, retina, href (по умолчанию #);
  youtube — id ролика: заголовок становится ссылкой на YouTube, а со скриптом открывает
  всплывающее окно с плеером (modules/video.js, окно — components/video-modal.hbs).
  Пример: {{> components/video-card data.cards.video}}
--}}
<article class="video-card">
  <div class="video-card__media">
    {{> components/img name=image alt="" width="357" height="201" retina=retina class="video-card__img" eager=false}}
    <span class="video-card__play" aria-hidden="true"></span>
    {{#if duration}}<span class="video-card__duration"><span class="visually-hidden">Длительность </span>{{duration}}</span>{{/if}}
  </div>
  <div class="video-card__body">
    {{#if youtube}}
      <a class="video-card__title" href="https://www.youtube.com/watch?v={{youtube}}" aria-haspopup="dialog" data-video="{{youtube}}">{{title}}</a>
    {{else}}
      <a class="video-card__title" href="{{#if href}}{{href}}{{else}}#{{/if}}">{{title}}</a>
    {{/if}}
    {{#if date}}<p class="video-card__date">{{date}}</p>{{/if}}
  </div>
</article>
