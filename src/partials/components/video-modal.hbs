{{!--
  Окно видео (scss/components/_video-modal.scss): модальный <dialog> с плеером 16 : 9.
  Открывается ссылками [data-video="id ролика YouTube"] (modules/video.js); плеер youtube-nocookie
  вставляется при открытии и удаляется при закрытии — видео не играет в фоне и не грузится заранее.
  На странице достаточно одного окна.
--}}
<dialog class="video-modal" aria-labelledby="video-modal-title" data-video-modal>
  <div class="video-modal__head">
    <p class="video-modal__title" id="video-modal-title" data-video-modal-title>Видео</p>
    <button class="video-modal__close" type="button" aria-label="Закрыть видео" data-video-modal-close>{{> components/icon name="close" size="24" label="" class=""}}</button>
  </div>
  <div class="video-modal__frame" data-video-modal-frame></div>
</dialog>
