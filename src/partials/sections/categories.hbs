{{!--
  Популярные категории (Figma: Category Section 46:1911): заголовок с табами и сетка 5 × 2 категорий.
  Каждому табу — своя панель (демо: хелпер rotate); на телефоне табы скрыты, видна первая панель-слайдер.
--}}
<section class="section" aria-labelledby="categories-title" data-tabs>
  <div class="container">
    <div class="section__head">{{> components/section-head title="Популярные категории" href="#" tabs=data.home.tabs arrows=false id="categories-title" tabsDesktop=true tabsId="categories"}}</div>
    {{#each data.home.tabs}}
      <div class="tab-panel" role="tabpanel" id="categories-panel-{{@index}}" aria-labelledby="categories-tab-{{@index}}"{{#unless @first}} hidden{{/unless}}>
        <div class="slider slider--lane" data-slider="xs">
          <div class="card-grid card-grid--cols-5 card-grid--md-cols-3 card-grid--scroll-xs" style="--scroll-item: 239px">
            {{#each (rotate @root.data.home.categories @index)}}{{> components/category-card caption=false large=false}}{{/each}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>
