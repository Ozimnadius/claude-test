{{!--
  Большой баннер (scss/sections/_hero.scss; Figma: Banner_Section 26:279).
  Текст баннера в макете скрыт — заголовок h1 страницы доступен только читалкам и поисковикам.
--}}
<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <h1 class="visually-hidden" id="hero-title">{{data.home.hero.title}}</h1>
    <a class="hero__banner" href="#" aria-describedby="hero-text">
      {{> components/img name="hero-bg" alt="" width="1696" height="550" retina=false class="hero__bg" eager=true}}
      {{> components/img name="hero-active" alt="" width="832" height="550" retina=false class="hero__active" eager=true}}
      <span class="visually-hidden" id="hero-text">{{data.home.hero.title}}. {{data.home.hero.text}}</span>
    </a>
  </div>
</section>
