{{!--
  Тематические подборки (Figma: Category Section 2, 47:2397): заголовок с табами и сетка 3 × 2 больших карточек.
  Каждому табу — своя панель (демо: хелпер rotate); на телефоне табы скрыты, видна первая панель-слайдер.
--}}
<section class="section" aria-labelledby="promos-title" data-tabs>
  <div class="container">
    <div class="section__head">{{> components/section-head title="Тематические подборки" href="#" tabs=data.home.tabs arrows=false id="promos-title" tabsDesktop=true tabsId="promos"}}</div>
    {{#each data.home.tabs}}
      <div class="tab-panel" role="tabpanel" id="promos-panel-{{@index}}" aria-labelledby="promos-tab-{{@index}}"{{#unless @first}} hidden{{/unless}}>
        <div class="slider slider--lane" data-slider="xs">
          <div class="card-grid card-grid--cols-3 card-grid--md-cols-2 card-grid--scroll-xs" style="--scroll-item: 320px">
            {{#each (rotate @root.data.home.promos @index 2)}}{{> components/category-card large=true caption=false width="561" height="511" retina=false}}{{/each}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>
