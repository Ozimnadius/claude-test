{{!-- Видеоотзывы (Figma: Videoreview Section 69:3018): заголовок со стрелкой и 4 видео через 24 px; граница снизу. Слайдер — modules/slider.js, открытие видео — modules/video.js. --}}
<section class="section section--divided" aria-labelledby="videos-title">
  <div class="container">
    <div class="section__head">{{> components/section-head title="Видеоотзывы" href="#" tabs=false arrows=false id="videos-title"}}</div>
    <div class="slider slider--lane" data-slider="md">
      <div class="card-grid card-grid--cols-4 card-grid--wide card-grid--scroll-md" style="--scroll-item: 305px">
        {{#each data.home.videos}}{{> components/video-card retina=false}}{{/each}}
      </div>
    </div>
  </div>
  {{> components/video-modal}}
</section>
