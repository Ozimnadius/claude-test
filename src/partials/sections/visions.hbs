{{!--
  Образы (Figma: Visions Section 88:25970): заголовок, описание, кнопки-фильтры и 2 образа через 24 px.
  Кнопки — табы (modules/tabs.js): у каждой своя панель с образами (data.home.visions.filters[].items).
  Выбранная кнопка — основная, остальные — светлые (как .btn--secondary).
--}}
<section class="section visions" aria-labelledby="visions-title" data-tabs>
  <div class="container">
    <div class="section__head section__head--stack">
      {{> components/section-head title="Образы" href="" tabs=false arrows=false id="visions-title"}}
      <p class="section__lead">{{data.home.visions.lead}}</p>
      <div class="visions__filters" role="tablist" aria-label="Подборки образов">
        {{#each data.home.visions.filters}}
          <button class="btn visions__filter" type="button" role="tab" id="visions-tab-{{@index}}" aria-controls="visions-panel-{{@index}}" aria-selected="{{#if @first}}true{{else}}false{{/if}}"{{#unless @first}} tabindex="-1"{{/unless}}><span class="btn__text">{{title}}</span></button>
        {{/each}}
      </div>
    </div>
    {{#each data.home.visions.filters}}
      <div class="tab-panel card-grid card-grid--cols-2 card-grid--wide card-grid--xs-cols-1" role="tabpanel" id="visions-panel-{{@index}}" aria-labelledby="visions-tab-{{@index}}"{{#unless @first}} hidden{{/unless}}>
        {{#each items}}{{> components/vision-card plain=false}}{{/each}}
      </div>
    {{/each}}
  </div>
</section>
