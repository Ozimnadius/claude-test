{{!-- Образы (Figma: Visions Section 88:25970): заголовок, описание, кнопки-фильтры и 2 образа через 24 px. Переключение фильтров — этап 6. --}}
<section class="section visions" aria-labelledby="visions-title">
  <div class="container">
    <div class="section__head section__head--stack">
      {{> components/section-head title="Образы" href="" tabs=false arrows=false id="visions-title"}}
      <p class="section__lead">{{data.home.visions.lead}}</p>
      <div class="visions__filters" role="group" aria-label="Подборки образов">
        {{#each data.home.visions.filters}}{{> components/btn text=this size="" variant="" icon="" href="" disabled=false class="visions__filter"}}{{/each}}
      </div>
    </div>
    <div class="card-grid card-grid--cols-2 card-grid--wide card-grid--xs-cols-1">
      {{#each data.home.visions.items}}{{> components/vision-card plain=false}}{{/each}}
    </div>
  </div>
</section>
